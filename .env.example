# Branding
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
# production: liinky.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support line on the help page (WhatsApp + call), E.164. Empty hides the buttons.
NEXT_PUBLIC_SUPPORT_PHONE=

# Web push (owner app). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@liinky.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI menu import and translations. AI_PROVIDER=fixture returns canned menus (local dev/E2E only).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Set to "off" where no Supabase Realtime server runs (the local stack): live screens poll instead.
NEXT_PUBLIC_REALTIME=
# Bearer token for POST /api/cron/nightly (subscription tick + cleanup; schedule it nightly).
CRON_SECRET=
